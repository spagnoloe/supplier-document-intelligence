# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Free-tier model used for extraction. Check https://ai.google.dev/gemini-api/docs/pricing
# for models marked "Free of charge" before changing it.
SDI_EXTRACTION_MODEL=gemini-3.5-flash-lite

# Where results and the LLM response cache are stored.
SDI_DB_PATH=sdi.db
SDI_LLM_CACHE_PATH=.cache/llm.db

# Sources processed in parallel; keep low to stay under free-tier requests-per-minute.
SDI_MAX_CONCURRENCY=2
